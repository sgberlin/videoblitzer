{
  "name": "videoblitzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web-app run dev",
    "dev:marketing": "npm --workspace apps/marketing-site run dev",
    "dev:api": "npm --workspace services/api run dev",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "overrides": {
    "postcss": "8.5.15",
    "undici": "6.27.0",
    "next": {
      "postcss": "8.5.15"
    },
    "app-builder-lib": {
      "@noble/hashes": "1.8.0"
    }
  },
  "devDependencies": {
    "@noble/hashes": "^1.8.0",
    "@types/node": "latest",
    "postcss": "8.5.15",
    "typescript": "latest"
  }
}
