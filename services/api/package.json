{
  "name": "@videoblitzer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "npm run typecheck && esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:@aws-sdk/* --external:@supabase/supabase-js --external:cors --external:dotenv --external:express --external:express-rate-limit --external:ffprobe-static --external:helmet --external:rate-limit-redis --external:redis --external:stripe --external:zod",
    "lint": "tsc --noEmit",
    "smoke:media-validation": "tsx scripts/smoke-media-validation.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@aws-sdk/s3-request-presigner": "latest",
    "@supabase/supabase-js": "latest",
    "@videoblitzer/export-presets": "file:../../packages/export-presets",
    "@videoblitzer/prompts": "file:../../packages/prompts",
    "@videoblitzer/shared-types": "file:../../packages/shared-types",
    "@videoblitzer/thumbnail-engine": "file:../../packages/thumbnail-engine",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "ffprobe-static": "^3.1.0",
    "helmet": "latest",
    "rate-limit-redis": "^5.0.0",
    "redis": "^5.12.1",
    "stripe": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "esbuild": "^0.28.1",
    "tsx": "latest",
    "typescript": "latest"
  }
}
