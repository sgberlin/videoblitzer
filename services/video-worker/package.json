{
  "name": "@videoblitzer/video-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "daemon": "tsx src/index.ts --daemon",
    "daemon:imports": "tsx src/index.ts --daemon --mode=imports",
    "daemon:exports": "tsx src/index.ts --daemon --mode=exports",
    "daemon:packages": "tsx src/index.ts --daemon --mode=packages",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "smoke:package-artifact": "tsx scripts/smoke-package-artifact.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@supabase/supabase-js": "^2.108.1",
    "@videoblitzer/export-presets": "file:../../packages/export-presets",
    "@videoblitzer/highlight-engine": "file:../../packages/highlight-engine",
    "@videoblitzer/shared-types": "file:../../packages/shared-types",
    "archiver": "^8.0.0",
    "dotenv": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^20.19.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}
